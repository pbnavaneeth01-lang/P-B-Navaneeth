{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information synchronized from Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "Exam": {
      "title": "Examination",
      "description": "A set of question papers and marking schemes for evaluation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "questionPaperUrl": { "type": "string" },
        "markingSchemeUrl": { "type": "string" },
        "qpPageCount": { "type": "number" },
        "msPageCount": { "type": "number" },
        "syncStatus": { "type": "string", "enum": ["ready", "syncing", "error"] },
        "studentList": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "questionPaperUrl", "markingSchemeUrl", "createdAt"]
    },
    "EvaluationQuestion": {
      "title": "Evaluation Question",
      "description": "Details of an individual question evaluation by AI.",
      "type": "object",
      "properties": {
        "questionNumber": { "type": "string" },
        "transcription": { "type": "string" },
        "marksAwarded": { "type": "number" },
        "maxMarks": { "type": "number" },
        "feedback": { "type": "string" },
        "pageNumber": { "type": "number" },
        "boundingBox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["questionNumber", "transcription", "marksAwarded", "maxMarks", "feedback", "pageNumber"]
    },
    "Submission": {
      "title": "Student Submission",
      "description": "A student's answer booklet submission and its AI evaluation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "examId": { "type": "string" },
        "studentName": { "type": "string" },
        "bookletUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "evaluated"] },
        "syncStatus": { "type": "string", "enum": ["ready", "syncing", "error"] },
        "totalMarks": { "type": "number" },
        "maxMarks": { "type": "number" },
        "pageCount": { "type": "number" },
        "evaluationData": {
          "type": "object",
          "properties": {
            "questions": {
              "type": "array",
              "items": { "$ref": "#/entities/EvaluationQuestion" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "examId", "studentName", "bookletUrl", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Public and private user profile data."
    },
    "exams/{examId}": {
      "schema": "Exam",
      "description": "Examination metadata and source files."
    },
    "submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Student booklets and evaluation results."
    }
  }
}
